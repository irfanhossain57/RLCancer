# ── Data directories (NEVER commit raw data) ─────────────────
data/
!data/.gitkeep

# ── Model weights (too large for GitHub — regenerate with train.py) ──
models/*.pt
models/*.zip
models/*.npy
models/*.h5ad
models/*.npz
models/scvi_vae*/
!models/.gitkeep

# ── MLflow: DO NOT IGNORE — reviewers must see experiment history ──
# mlruns/      ← REMOVED: keep mlruns in the repo
# mlartifacts/ ← REMOVED: keep artifacts too

# ── Python cache ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── Virtual environment ──────────────────────────────────────
sc_rlot_env/
venv/
.venv/
env/

# ── Jupyter / IPython ────────────────────────────────────────
.ipynb_checkpoints/

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE files ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Streamlit cache (local only, not needed in repo) ─────────
.streamlit/

# ── Credentials and secrets ──────────────────────────────────
*.env
.env
secrets.yaml
kaggle.json

# ── Artifacts: keep PNGs and CSVs (they are your screenshots) ──
# artifacts/*.png ← REMOVED
# artifacts/*.csv ← REMOVED
!artifacts/.gitkeep
